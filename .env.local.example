# Kick OAuth — register your app at https://kick.com/settings/developer
# Redirect URI to register: https://mr-ai.dev/kick/api/auth/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# iron-session — at least 32 characters; sign-in fails without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# App
PORT=3008
NEXT_PUBLIC_BASE_URL=https://mr-ai.dev/kick
NEXT_PUBLIC_BASE_PATH=/kick
TZ=Asia/Singapore

# Kick user ID of the dashboard admin, who can open every channel
ADMIN_KICK_USER_ID=

# Bot enrollment service (Kick-Chatbot-Deployment), loopback only.
# INTERNAL_API_SECRET must match the service's; without it every change returns 503.
BOT_API_URL=http://127.0.0.1:3006
INTERNAL_API_SECRET=

# Bot data the earnings pages read
KPP_ROOT=/home/you/Kick-Chatbot-Deployment/data/kpp
LOGS_DIR=/home/you/Kick-Chatbot-Deployment/logs
