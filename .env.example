# Kick Chatbot configuration.
# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Only the "Required" block is needed to start the bot. Everything else
# switches on an optional command or integration; leave a key blank and the
# command it powers simply stays off.

# ─────────────────────────────── Required ────────────────────────────────

# From your app at https://dev.kick.com
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# The Kick account the bot posts as, and the account allowed to run
# owner-only commands (points config, KPP rate, enrollment).
KICK_USERNAME=your_bot_account
KICK_OWNER=your_kick_username

# ────────────────────────────── OAuth server ─────────────────────────────

# Where the OAuth callback listens. OAUTH_DOMAIN must match the redirect URL
# registered on dev.kick.com. Use a real hostname if the bot is not on the
# same machine as the browser you authorise from.
OAUTH_PORT=3004
OAUTH_DOMAIN=localhost

# Set to "false" ONLY for local testing — it disables Kick's webhook
# signature check, so anyone could post forged events to your endpoint.
WEBHOOK_VERIFY=true

# ──────────────────────────────── General ────────────────────────────────

# Command prefix for !commands. The $DON points commands always use "$".
BOT_PREFIX=!

# How many channels one process will join.
MAX_KICK_CHANNELS=10

# Absolute path to this checkout. Defaults to the directory above /dist,
# which is correct for a normal install — set it only if you relocate things.
# BOT_FULL_PATH=/opt/kick-chatbot

# Public URL of the companion dashboard, used by "$don leaderboard".
# Point this at your own deployment.
BOT_DASHBOARD_URL=https://example.com/kick

# ───────────────────────── Optional: AI commands ─────────────────────────

# !claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Web search for !claude — https://brave.com/search/api
BRAVE_SEARCH_API_KEY=

# ──────────────────────── Optional: other commands ───────────────────────

# !fx currency conversion — https://exchangerate-api.com
EXCHANGERATE_API_KEY=

# !clip — a browser session token for Kick's internal clip API.
# Copied by hand from a logged-in browser; automated logins get rate limited.
KICK_SESSION_TOKEN=

# !blerp — sound suggestions. Supply BLERP_JWT directly, or the
# email/password pair to have one fetched. JWTs expire, so expect to refresh.
BLERP_JWT=
BLERP_EMAIL=
BLERP_PASSWORD=

# ────────────────────── Optional: bot account login ──────────────────────

# Used by helpers that drive a logged-in browser session rather than the
# official API. Not needed for normal OAuth operation.
KICK_BOT_EMAIL=
KICK_BOT_PASSWORD=

# Chromium/Chrome binary for those browser-driven helpers.
# CHROME_PATH=/usr/bin/chromium

# ───────────────────── Optional: $DON points system ──────────────────────

# Where the per-channel SQLite databases live. Defaults to ./data
# POINTS_DATA_ROOT=/var/lib/kick-chatbot/data

# SQLite busy timeout in ms (default 5000). Raise it on slow storage.
# POINTS_BUSY_TIMEOUT_MS=5000

# Set to 1 to run the points self-test instead of starting normally.
# POINTS_SELFTEST=1

# ──────────────────── Optional: enrollment / operations ──────────────────

# The channel the enrollment bot announces in, plus its chatroom ids.
# Only needed if you run the self-service enrollment flow.
KICK_DEPLOYMENT_CHANNEL=
KICK_DEPLOYMENT_CHATROOM_ID=
KICK_DEPLOYMENT_PROFILE_CHATROOM_ID=

# Port for the chatroom-id finder helper.
CHATROOM_FINDER_PORT=3006

# Shared secret between the bot and the dashboard's internal API.
# Generate a long random string; both sides must match.
INTERNAL_API_SECRET=

# Telegram alerts for operational errors — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
